{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Reggie",
  "identifier": "xyz.thebananastandard.reggie",
  "version": "2.0.1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Reggie",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/agents/*": "reggie-resources/agents",
      "../resources/commands/*": "reggie-resources/commands",
      "../resources/hooks/*": "reggie-resources/hooks",
      "../resources/docs/*": "reggie-resources/docs",
      "../resources/registries/*": "reggie-resources/registries"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:reggie.db"]
    }
  }
}
