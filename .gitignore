dist/
src-tauri/target/
src-tauri/gen/

# Environment and secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.db-journal

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Test coverage
coverage/

# TypeScript build info
*.tsbuildinfo

# Pipeline and worktrees
.pipeline/
.worktree/

# Build artifacts
*.dmg
*.app
*.msi
*.AppImage
*.deb

# Temp files
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*~

# Reggie local configs
.claude/*
!.claude/commands/
capability-manifest.yaml
mcp-registry.local.yaml
skills-registry.local.yaml
articles/
.pipeline/
.worktree/

# Pipeline
.pipeline/
.worktree/

