{
  "name": "reggie",
  "version": "3.0.0-alpha.1",
  "description": "Reggie: a repo manager for Claude Code and Codex. Keeps tasks, plans, notes, and journals in the repo; derives state from git; serves a web view that explains the code and the work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Banana-Standard/reggie"
  },
  "keywords": [
    "reggie",
    "repo-manager",
    "claude-code",
    "codex",
    "mcp",
    "ai"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix packages/reggie run build",
    "test": "npm --prefix packages/reggie run test",
    "test:watch": "npm --prefix packages/reggie run test:watch",
    "typecheck": "npm --prefix packages/reggie run typecheck",
    "serve": "npm --prefix packages/reggie run dev -- serve"
  }
}
